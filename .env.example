# Скопируй в .env и впиши свои значения:  cp .env.example .env
# .env в .gitignore -- в репозиторий он не попадёт. Токены не коммить
# и никому не пересылай: с токеном любой может управлять ботом.

# Токен основного бота (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# id админов в Telegram через запятую. Свой id бот печатает в консоли,
# когда ты пишешь ему /start.
ADMINS=
